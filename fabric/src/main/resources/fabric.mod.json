{
  "schemaVersion": 1,
  "id": "thatmakessense",
  "version": "${version}",
  "name": "That Makes Sense",
  "description": "A collection of quality-of-life tweaks that make Minecraft behave the way you'd expect.",
  "authors": [
    "Kestalkayden"
  ],
  "contact": {
    "homepage": "https://github.com/kestalkayden/that-makes-sense",
    "sources": "https://github.com/kestalkayden/that-makes-sense"
  },
  "license": "MIT",
  "icon": "assets/thatmakessense/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kestalkayden.thatmakessense.ThatMakesSenseFabric"
    ],
    "client": [
      "com.kestalkayden.thatmakessense.client.ThatMakesSenseFabricClient"
    ],
    "modmenu": [
      "com.kestalkayden.thatmakessense.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "thatmakessense.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": ">=1.21.1 <1.21.2",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
